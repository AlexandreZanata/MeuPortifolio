# The site needs no environment variables to build or run.
#
# Optional, for local tooling only:

# Raises the GitHub API rate limit for `pnpm github:snapshot` (60 -> 5000 requests/hour).
# A token with no scopes is enough: only public data is read.
# GITHUB_TOKEN=

# Path to a Chromium/Chrome binary, for machines where `playwright install` is not an
# option. Used by `pnpm test:e2e` and `pnpm og`.
# CHROMIUM_PATH=
